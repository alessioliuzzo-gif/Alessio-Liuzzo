{
  "expo": {
    "name": "DayShot",
    "slug": "dayshot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dayshot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ch.dayshot.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B2622",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ch.dayshot.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF4EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#2B2622",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "DayShot braucht Zugriff auf deine Fotos, damit du ein Bild als Tagesfoto oder Profilbild auswählen kannst.",
          "cameraPermission": "DayShot braucht Zugriff auf die Kamera, damit du dein Tagesfoto aufnehmen kannst.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "highway-production",
    "extra": {
      "eas": {
        "projectId": "2bf93e3e-5f42-4334-9b76-8efafc0d8242"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bf93e3e-5f42-4334-9b76-8efafc0d8242"
    }
  }
}
