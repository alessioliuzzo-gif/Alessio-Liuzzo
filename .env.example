# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ".env" wird nicht ins Repository übernommen (siehe .gitignore).
#
# Achtung: Alles mit dem Präfix EXPO_PUBLIC_ landet in der App und ist öffentlich.
# Hier nur die öffentlichen Supabase-Werte eintragen, niemals den
# service_role/secret Key oder Keys von Stripe und Gelato.

# Supabase > Projekteinstellungen > API (ab Phase 1 nötig)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
